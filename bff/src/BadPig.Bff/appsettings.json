{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://auth.badpig.fr/application/o/badpig-test/",
    "ClientId": "badpig-test-web",
    "ClientSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://badpig-test-api:8080/" }
        }
      }
    }
  }
}
