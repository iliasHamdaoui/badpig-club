# Copy to .env (never committed to Git).
# Secret of the OIDC client "badpig-test-web" (provider "Provider for BadPig test (site web)" in Authentik).
OIDC_CLIENT_SECRET=
# API token of the badpig-api-test service account WARNING: it acts on the users of the TEST Authentik.
AUTHENTIK_API_TOKEN=
# Optional: slug/name of the invitation stage (same value as Authentik__InvitationStage in deploy/test/.env).
AUTHENTIK_INVITATION_STAGE=
# Stripe TEST secret key (sk_test_...), from the Stripe dashboard in test mode. Needed to place an order in the shop.
STRIPE_SECRET_KEY=
# Optional locally: signing secret (whsec_...) printed by "stripe listen". Without it the order page still updates by itself when you come back from the payment.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=