# Copy to .env (chmod 600). This file must NEVER be added to Git.
IMAGE_WEB=ghcr.io/YOUR_GITHUB_ACCOUNT/badpig-club-web
IMAGE_API=ghcr.io/YOUR_GITHUB_ACCOUNT/badpig-club-api
TAG=test
# "API Token" of the badpig-api-test service account (in 1Password)
Authentik__ApiToken=
# PostgreSQL connection: the password is in /opt/badpig/postgres/secrets/badpig_test_password
ConnectionStrings__Base="Host=postgres;Database=badpig_test;Username=badpig_test;Password=TO_REPLACE"
# Shop (Stripe, TEST mode keys while testing; the live keys only in production). Secrets: 1Password, never Git.
Stripe__SecretKey=
Stripe__WebhookSecret=
# Public address of the site (no secret): Stripe sends the person back there after the payment
Shop__SiteUrl=https://test.badpig.fr
