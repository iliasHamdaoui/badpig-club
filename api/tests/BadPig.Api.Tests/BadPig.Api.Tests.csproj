<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>BadPig.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <!-- Starts the real application in memory. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <!-- A real PostgreSQL database in a Docker container; Respawn empties it between two tests. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Respawn" Version="6.*" />
    <!-- Respawn brings these two through Microsoft.Data.SqlClient, in versions with known vulnerabilities (test project only, never shipped):
         referencing a patched version here replaces them. -->
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="System.Drawing.Common" Version="9.*" />
    <!-- Substitutes for what lives outside of the application: the identity provider, the e-mails and the clock. -->
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BadPig.Api\BadPig.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

</Project>
